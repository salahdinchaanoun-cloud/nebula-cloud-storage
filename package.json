    "@itsliaaa/baileys": "^0.3.18",
    "@sentry/node": "^8.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-static": "^0.400.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
