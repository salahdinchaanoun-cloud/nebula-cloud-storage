<%- include('partials/head') %><link rel="stylesheet" href="/api.css"><section class="api-page"><div class="page-heading"><div><span class="eyebrow">API ACCESS</span><h1>مفاتيح API</h1></div><a class="btn ghost small" href="/api-files">ملفات API ↗</a><a class="btn ghost small" href="/api/docs">التوثيق ↗</a></div>
<% if (newKey) { %><div class="panel api-new"><h2>انسخ المفتاح الآن</h2><p class="muted">هذا المفتاح لن يُعرض مرة أخرى. إن فقدته فألغِه وأنشئ مفتاحاً جديداً.</p><div class="copy-row"><code dir="ltr"><%= newKey %></code><button type="button" class="btn primary small" data-copy="<%= newKey %>">نسخ المفتاح</button></div></div><% } %>
<div class="panel"><h2>إنشاء مفتاح جديد</h2><div class="copy-row"><span class="muted">عنوان الواجهة:</span><code dir="ltr"><%= apiBase %>/api/v1</code><button type="button" class="btn ghost small" data-copy="<%= apiBase %>/api/v1">نسخ العنوان</button></div><p class="muted">يمكنك إنشاء حتى <%= maxKeys %> مفاتيح نشطة. استخدم مفتاحاً منفصلاً لكل بوت أو تطبيق حتى تلغي أحدها دون أن يتأثر الباقي.</p>
<form method="post" action="/api-keys" class="api-form"><input name="name" maxlength="60" placeholder="مثال: بوت واتساب الرئيسي" required><button class="btn primary" type="submit">إنشاء مفتاح</button></form></div>
<div class="panel"><h2>مفاتيحك</h2>
<% if (!keys.length) { %><p class="muted">لا توجد مفاتيح بعد.</p><% } else { %>
<div class="table-wrap"><table class="api-table"><thead><tr><th>الاسم</th><th>المفتاح</th><th>أُنشئ</th><th>آخر استخدام</th><th>الحالة</th><th></th></tr></thead><tbody>
<% keys.forEach(k => { %><tr><td><%= k.name %></td><td dir="ltr"><code><%= k.key_prefix %>…</code></td><td><%= (k.created_at || '').slice(0,10) %></td><td><%= k.last_used_at ? k.last_used_at.slice(0,16) : 'لم يُستخدم بعد' %></td><td><%= k.revoked_at ? 'ملغى' : 'نشط' %></td><td><% if (!k.revoked_at) { %><form method="post" action="/api-keys/<%= k.id %>/revoke"><button class="btn small danger" type="submit">إلغاء</button></form><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div></section><%- include('partials/foot') %>
