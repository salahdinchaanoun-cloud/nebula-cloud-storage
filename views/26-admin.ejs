<%- include('partials/head') %><link rel="stylesheet" href="/admin.css"><div class="adm-banner" aria-hidden="true"><img src="https://images.unsplash.com/photo-1614064642578-7faacdc6336e?auto=format&fit=crop&w=1600&q=70" alt="" loading="eager" onerror="this.parentNode.remove()"><div class="adm-banner-shade"></div></div><section class="page-heading"><div><div class="eyebrow">SYSTEM CONTROL / ADMIN</div><h1>مركز <span class="gradient-text">التحكم</span></h1><p class="muted">إدارة المستخدمين، المساحات، الملفات، والصلاحيات.</p></div><div class="heading-badge admin-badge">◆ ADMIN ACCESS</div></section>
<section class="stats-row"><div class="stat-card"><small>إجمالي المستخدمين</small><strong><%= stats.users %></strong><span>حساب مسجل</span></div><div class="stat-card"><small>الملفات المخزنة</small><strong><%= stats.files %></strong><span>ملف في النظام</span></div><div class="stat-card"><small>إجمالي التخزين</small><strong><%= formatBytes(stats.bytes) %></strong><span>حجم الملفات الحالية</span></div></section>
<section class="panel admin-panel"><div class="section-title"><div><div class="eyebrow">PLATFORM ACTIVITY</div><h2>نشاط المنصة · آخر 14 يوماً</h2></div><span class="muted">ملفات مرفوعة وحسابات جديدة</span></div>
<% const max=Math.max(1,...activity.map(a=>Math.max(a.uploads,a.signups))); %>
<svg viewBox="0 0 700 200" width="100%" role="img" aria-label="مخطط نشاط المنصة" style="direction:ltr;display:block">
<% activity.forEach((a,i)=>{ const x=i*50+8; const hU=Math.round(a.uploads/max*150); const hS=Math.round(a.signups/max*150); %>
<rect x="<%= x %>" y="<%= 160-hU %>" width="18" height="<%= hU %>" rx="4" fill="#8c6cff"><title>ملفات: <%= a.uploads %></title></rect>
<rect x="<%= x+20 %>" y="<%= 160-hS %>" width="18" height="<%= hS %>" rx="4" fill="#69e4ef"><title>حسابات: <%= a.signups %></title></rect>
<text x="<%= x+19 %>" y="185" font-size="10" fill="#8d96b7" text-anchor="middle"><%= a.day %></text>
<% }) %>
</svg>
<div class="chart-legend"><span><i style="background:#8c6cff"></i>ملفات مرفوعة</span><span><i style="background:#69e4ef"></i>حسابات جديدة</span></div>
</section>
<section class="panel admin-panel"><div class="section-title"><div><div class="eyebrow">OBJECT STORAGE</div><h2>مساحة S3</h2></div></div>
<% storages.forEach(s=>{ %><div class="storage-row"><div class="storage-head"><b><%= s.name %></b><span><%= s.pct %>%</span></div><div class="progress"><i style="width:<%= s.pct %>%"></i></div><div class="storage-meta"><span>مستخدم: <b><%= formatBytes(s.used) %></b></span><span>متبقٍ: <b><%= formatBytes(s.free) %></b></span><span>السعة: <b><%= formatBytes(s.capacity) %></b></span><span>ملفات: <b><%= s.files %></b></span></div></div><% }) %>
<% if(!storages.length){ %><p class="muted">لا توجد خدمات تخزين مفعّلة.</p><% } %>
</section>
<section class="panel admin-panel"><div class="section-title"><div><div class="eyebrow">ADD STORAGE</div><h2>إضافة خدمة تخزين S3</h2></div><span class="muted">يتم اختبار الاتصال قبل الحفظ</span></div>
<form method="post" action="/admin/storages" class="storage-form">
<label>الاسم<input name="name" maxlength="60" required placeholder="مثال: Joy 2027"></label>
<label>نقطة النهاية<input name="endpoint" type="url" required placeholder="https://nz.in.s3.joy.services"></label>
<label>المنطقة<input name="region" placeholder="default أو us-east-1"></label>
<label>اسم الحاوية<input name="bucket" required placeholder="my-bucket"></label>
<label>مفتاح الوصول<input name="access_key_id" required autocomplete="off"></label>
<label>المفتاح السري<input name="secret_access_key" type="password" required autocomplete="new-password"></label>
<label>الدور<select name="role"><option value="storage">تخزين ملفات</option></select></label><label>السعة (GB)<input name="capacity_gb" type="number" min="1" max="1000000" required value="100"></label>
<button class="mini-btn" type="submit">اختبار وحفظ</button>
</form>

<div class="panel" style="margin:18px 0"><h3 style="margin:0 0 12px">الرفع خلال 14 يوماً</h3><canvas id="uploads-chart" height="120" data-labels="<%= JSON.stringify(chart.labels) %>" data-values="<%= JSON.stringify(chart.values) %>"></canvas></div>
<script src="/vendor/chart.js/chart.umd.js" defer></script>
<script src="/admin-charts.js?v=1" defer></script>
<p style="margin:14px 0"><a class="btn ghost small" href="/admin/activity">سجل النشاط</a> <a class="btn ghost small" href="/admin/stats">الإحصاءات</a> <a class="btn ghost small" href="/admin/users">الحصص</a> <a class="btn ghost small" href="/admin/telegram">بوت تيليجرام</a> <a class="btn ghost small" href="/admin/anime-check">فحص اتصال الأنمي</a></p>
<h3 style="margin:22px 0 10px;font-size:15px">معلومات الحاويات</h3>
<div class="table-wrap"><table class="container-table"><thead><tr><th>الحاوية</th><th>الملفات</th><th>المصدر</th><th>Endpoint</th><th>Region</th><th>Bucket</th><th>Access Key ID</th><th>السر</th></tr></thead><tbody>
<% containers.forEach(c=>{ %><tr><td><b><%= c.name %></b><small class="table-sub"><%= c.role==='backup'?'نسخ احتياطي':'تخزين' %> · <%= c.capacityGb %> GB · <%= c.enabled===false?'معطّلة':'مفعّلة' %></small></td><td><% if (c.files !== null) { %><b><%= c.files %></b> ملف<small class="table-sub"><%= formatBytes(c.bytes) %></small><% } else { %><button type="button" class="mini-btn count-btn" data-count="<%= c.id %>">عدّ الملفات</button><small class="table-sub count-out"></small><% } %><br><a class="mini-btn" href="/admin/containers/<%= c.id %>/files" style="display:inline-block;margin-top:6px">عرض الملفات</a></td><td><%= c.source==='env'?'متغيرات البيئة':'لوحة الإدارة' %></td><td dir="ltr"><code><%= c.endpoint %></code></td><td dir="ltr"><%= c.region %></td><td dir="ltr"><%= c.bucket %></td><td dir="ltr"><code><%= c.accessKeyId %></code></td><td><button type="button" class="mini-btn reveal-btn" data-container="<%= c.id %>">كشف السر</button><div class="secret-box" hidden><code dir="ltr"></code><button type="button" class="mini-btn copy-secret">نسخ</button></div></td></tr><% }) %>
</tbody></table></div>
<p class="muted" style="font-size:12px">السر لا يظهر إلا عند الطلب، ويُخفى تلقائياً بعد 30 ثانية، وكل كشف يُسجَّل في سجل الخادم.</p>
<script src="/admin-containers.js?v=1" defer></script>
<% if(dbStorages.length){ %><div class="table-wrap"><table><thead><tr><th>الخدمة</th><th>الحاوية</th><th>الدور</th><th>السعة</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody><% dbStorages.forEach(s=>{ %><tr><td><b><%= s.name %></b><small class="table-sub"><%= s.endpoint %></small></td><td><%= s.bucket %></td><td><%= s.role==='backup'?'نسخ احتياطي':'تخزين' %></td><td><%= s.capacity_gb %> GB</td><td><span class="pill <%= s.enabled?'pill-on':'pill-off' %>"><%= s.enabled?'مفعّلة':'معطّلة' %></span></td><td><div class="admin-actions"><form method="post" action="/admin/storages/<%= s.id %>/toggle"><button class="mini-btn"><%= s.enabled?'تعطيل':'تفعيل' %></button></form><form method="post" action="/admin/storages/<%= s.id %>/delete" onsubmit="return confirm('حذف هذه الخدمة من المنصة؟')"><button class="mini-btn mini-danger">حذف</button></form></div></td></tr><% }) %></tbody></table></div><% } %>
<style>.storage-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:18px}.storage-form label{display:flex;flex-direction:column;gap:6px;font-size:13px}.storage-form input{padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);color:inherit}.storage-form button{align-self:end;height:42px}</style>
</section>
<section class="panel admin-panel"><div class="section-title"><div><div class="eyebrow">ACCOUNT DIRECTORY</div><h2>المستخدمون</h2></div><span class="count-pill"><%= users.length %></span></div><div class="table-wrap"><table><thead><tr><th>المستخدم</th><th>الصلاحية</th><th>التخزين</th><th>الحالة</th><th>إجراءات الإدارة</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><b><%= u.name %></b><small class="table-sub"><%= u.email %></small><small class="table-sub">انضم: <%= u.created_at %></small></td><td><span class="pill <%= u.role==='admin'?'pill-admin':'' %>"><%= u.role==='admin'?'مدير':'مستخدم' %></span></td><td><b><%= formatBytes(u.used) %></b><small class="table-sub">من <%= formatBytes(u.quota_bytes) %></small><form class="inline quota-form" method="post" action="/admin/users/<%= u.id %>/quota"><input type="number" name="quota_mb" min="1" max="1048576" value="<%= Math.max(1,Math.round(u.quota_bytes/1048576)) %>" aria-label="المساحة بالميغابايت"><button class="mini-btn">تحديث MB</button></form></td><td><span class="pill <%= u.disabled?'pill-off':'pill-on' %>"><%= u.disabled?'موقوف':'نشط' %></span></td><td><div class="admin-actions"><form method="post" action="/admin/users/<%= u.id %>/role"><button class="mini-btn"><%= u.role==='admin'?'جعله مستخدماً':'ترقية لمدير' %></button></form><form method="post" action="/admin/users/<%= u.id %>/toggle"><button class="mini-btn"><%= u.disabled?'تفعيل':'إيقاف' %></button></form><% if(u.id!==user.id){ %><form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('سيتم حذف المستخدم وجميع ملفاته نهائياً. متابعة؟')"><button class="mini-btn mini-danger">حذف الحساب</button></form><% } %></div></td></tr><% }) %></tbody></table></div></section>
<section class="panel admin-panel"><div class="section-title"><div><div class="eyebrow">RECENT ACTIVITY</div><h2>أحدث الملفات</h2></div></div><div class="table-wrap"><table><thead><tr><th>اسم الملف</th><th>المالك</th><th>الحجم</th><th>التاريخ</th><th>إجراء</th></tr></thead><tbody><% files.forEach(f=>{ %><tr><td><%= f.original_name %></td><td><%= f.owner_email %></td><td><%= formatBytes(f.size_bytes) %></td><td><%= f.created_at %></td><td><div class="admin-actions"><a class="mini-btn" href="/files/<%= f.id %>/download">تنزيل</a><form method="post" action="/files/<%= f.id %>/delete" onsubmit="return confirm('حذف الملف نهائياً؟')"><button class="mini-btn mini-danger">حذف</button></form></div></td></tr><% }) %></tbody></table></div></section><button type="button" class="ai-bubble" id="admin-ai-btn" aria-label="مساعد الإدارة"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg></button>
<div class="ai-panel" id="admin-ai-panel" hidden>
  <div class="ai-panel-head"><b>مساعد الإدارة</b><div class="ai-head-tools"><button type="button" id="admin-ai-clear" class="ai-tool">مسح</button><button type="button" id="admin-ai-close" class="ai-x" aria-label="إغلاق">×</button></div></div>
  <div class="ai-log-admin" id="admin-ai-log"></div>
  <form id="admin-ai-form" class="ai-form-admin"><textarea id="admin-ai-input" rows="2" maxlength="2000" placeholder="اكتب سؤالك…" aria-label="سؤالك"></textarea><button class="btn small primary" type="submit">إرسال</button></form>
</div>
<script src="/admin-ai.js?v=1" defer></script>
<%- include('partials/foot') %>