<%- include('partials/head') %><section class="feature-page"><div class="page-heading"><div><span class="eyebrow">TELEGRAM</span><h1>بوت تيليجرام</h1></div><a class="btn ghost small" href="/admin">العودة للوحة الإدارة</a></div>
<form method="post" action="/admin/telegram" class="panel tg-form">
<label class="field">توكن البوت (من @BotFather)<input name="token" type="password" autocomplete="off" placeholder="<%= hasToken ? 'محفوظ، اتركه فارغاً للإبقاء عليه' : '123456:ABC...' %>"></label>
<label class="field">معرّفات المدراء في تيليجرام (واحد في كل سطر)<textarea name="admin_ids" rows="4" placeholder="1542918041"><%= adminIds %></textarea></label>
<p class="muted">يمكن معرفة معرّفك من بوت مثل @userinfobot. التوكن يُحفظ مشفّراً ولا يظهر مرة أخرى.</p>
<button class="btn primary" type="submit">حفظ وربط البوت</button></form></section><%- include('partials/foot') %>
