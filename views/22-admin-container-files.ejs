<%- include('partials/head') %><section class="feature-page"><div class="page-heading"><div><span class="eyebrow">CONTAINER</span><h1><%= container.name %></h1></div><a class="btn ghost small" href="/admin">العودة للوحة الإدارة</a></div>
<div class="panel"><p class="muted"><%= container.role === 'backup' ? 'حاوية نسخ احتياطي' : 'حاوية تخزين' %> · <%= container.bucket %> · <%= rows.length %> ملف معروض<% if (truncated) { %> (أول 500 فقط)<% } %></p></div>
<div class="table-wrap"><table class="container-table"><thead><tr><th>الملف</th><th>المالك</th><th>الحجم</th><th>التاريخ</th></tr></thead><tbody>
<% rows.forEach(r => { %><tr><td dir="ltr" style="text-align:right"><%= r.name %></td><td><%= r.owner %></td><td><%= r.size %></td><td><%= r.date %></td></tr><% }) %>
<% if (!rows.length) { %><tr><td colspan="4" class="muted">لا توجد ملفات داخل هذه الحاوية.</td></tr><% } %>
</tbody></table></div></section><%- include('partials/foot') %>
